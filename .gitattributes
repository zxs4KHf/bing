* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf

# Windows launchers keep native line endings.
*.ps1 text eol=crlf
*.bat text eol=crlf

# Repository documentation, configuration, and datasets stay stable across platforms.
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.psd1 text eol=lf
*.psm1 text eol=lf
